{
  "name": "noobheaders",
  "version": "2.2.1",
  "description": "Simple, privacy-focused, local-first browser extension to modify HTTP headers. No ads, no tracking. Built for developers and noobs 🚀",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "node scripts/build.js",
    "build:dev": "node scripts/build.js --dev",
    "build:watch": "node scripts/build.js --dev --watch",
    "clean": "rimraf dist",
    "test": "node scripts/build.js --dev && node --test tests/*.test.js",
    "test:e2e": "pnpm run package && playwright test",
    "test:e2e:chromium": "pnpm run package && playwright test --project=chromium",
    "test:e2e:firefox": "pnpm run package && playwright test --project=firefox",
    "test:e2e:ui": "pnpm run package && playwright test --ui",
    "test:e2e:debug": "pnpm run package && playwright test --debug",
    "test:firefox": "node scripts/test-firefox.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "husky",
    "semantic-release:dry": "semantic-release --dry-run",
    "format": "biome format --write .",
    "check": "pnpm build && biome check --write . && pnpm test",
    "icons": "node scripts/generate-icons.js",
    "semantic-release": "semantic-release",
    "package": "pnpm build && node scripts/package.js"
  },
  "keywords": [
    "chrome-extension",
    "firefox-addon",
    "http-headers",
    "developer-tools",
    "modheader-alternative",
    "cors",
    "user-agent",
    "no-ads",
    "privacy-focused",
    "open-source"
  ],
  "author": "BioSs54",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BioSs54/noobheaders.git"
  },
  "bugs": {
    "url": "https://github.com/BioSs54/noobheaders/issues"
  },
  "homepage": "https://github.com/BioSs54/noobheaders#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/chrome": "^0.3.0",
    "archiver": "^8.0.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "web-ext": "^10.7.0"
  },
  "volta": {
    "node": "22.22.2"
  }
}
